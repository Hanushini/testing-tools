	"item": [
		{
			"name": "Freightos - shippingCalculator [Box Shipment] - JSON",
			"item": [
				{
					"name": "Box Shipment - Orgn=CN & Dst=US",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"/*pm.test(\"Response time is below 3000ms\", function () {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
									"});*/\r",
									"\r",
									"pm.test(\"Response object exists\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData).to.have.property(\"response\");\r",
									"});\r",
									"\r",
									"pm.test(\"estimatedFreightRates is present\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.response).to.have.property(\"estimatedFreightRates\");\r",
									"});\r",
									"\r",
									"pm.test(\"Mode array is not empty\", function () {\r",
									"    const modes = pm.response.json().response.estimatedFreightRates.mode;\r",
									"    pm.expect(modes.length).to.be.greaterThan(0);\r",
									"});\r",
									"\r",
									"pm.test(\"Expected shipping modes are available\", function () {\r",
									"    const modes = pm.response.json().response.estimatedFreightRates.mode\r",
									"        .map(m => m.mode);\r",
									"\r",
									"    pm.expect(modes).to.include.members([\"air\", \"express\", \"LCL\"]);\r",
									"});\r",
									"\r",
									"pm.test(\"Min price is less than max price for each mode\", function () {\r",
									"    const modes = pm.response.json().response.estimatedFreightRates.mode;\r",
									"\r",
									"    modes.forEach(m => {\r",
									"        pm.expect(m.price.min.moneyAmount.amount)\r",
									"            .to.be.below(m.price.max.moneyAmount.amount);\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Currency is USD for all modes\", function () {\r",
									"    const modes = pm.response.json().response.estimatedFreightRates.mode;\r",
									"\r",
									"    modes.forEach(m => {\r",
									"        pm.expect(m.price.min.moneyAmount.currency).to.eql(\"USD\");\r",
									"        pm.expect(m.price.max.moneyAmount.currency).to.eql(\"USD\");\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Transit time min is less than max\", function () {\r",
									"    const modes = pm.response.json().response.estimatedFreightRates.mode;\r",
									"\r",
									"    modes.forEach(m => {\r",
									"        pm.expect(m.transitTimes.min)\r",
									"            .to.be.below(m.transitTimes.max);\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Transit time unit is days\", function () {\r",
									"    const modes = pm.response.json().response.estimatedFreightRates.mode;\r",
									"\r",
									"    modes.forEach(m => {\r",
									"        pm.expect(m.transitTimes.unit).to.eql(\"days\");\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Number of quotes matches mode count\", function () {\r",
									"    const data = pm.response.json().response.estimatedFreightRates;\r",
									"    pm.expect(data.numQuotes).to.eql(data.mode.length);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
