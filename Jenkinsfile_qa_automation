pipeline {
    agent any

    environment {
        ENVIRONMENT = "${params['Environment']}"
        POSTMAN_COLLECTION = "${params['Test Modules']}"
        EMAIL_LIST = "${params['Email List']}"
        TEST_FAILED = 'false'
    }

    stages {

        stage('Run Postman Tests') {
            steps {
                script {
                    try {
			bat """
podman run --rm ^
  -v "//c/Users/lhanu/.jenkins/workspace/API-Test-Automation:/etc/newman" ^
  newman-tests:22 ^
  newman run /etc/newman/Freightos-Box-Shipment-Calculator-API.postman_collection.json ^
  -e /etc/newman/TEST.postman_environment.json ^
  -r cli,htmlextra ^
  --reporter-htmlextra-title "API Automation Test Report" ^
  --reporter-htmlextra-theme flatly ^
  --reporter-htmlextra-logs true ^
  --reporter-htmlextra-showOnlyFails false ^
  --reporter-htmlextra-export /etc/newman/report.html
"""


                    } catch (e) {
                        env.TEST_FAILED = 'true'
                        throw e
                    }
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                reportName: 'Postman API Test Report',
                reportDir: '.',
                reportFiles: 'report.html',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: false
            ])
        }
    }
}
