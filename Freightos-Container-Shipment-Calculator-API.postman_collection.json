			"name": "Freightos - shippingCalculator [Container Shipment] - XML",
			"item": [
				{
					"name": "Container Shipment - Orgn=CNSHA & Dst=USLGB",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Get XML response as text\r",
									"let xml = pm.response.text();\r",
									"\r",
									"// 1. Status code is 200\r",
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
									"\r",
									"// 2. estimatedFreightRates exists\r",
									"pm.test(\"estimatedFreightRates exists\", () => {\r",
									"    pm.expect(/<estimatedFreightRates/.test(xml)).to.be.true;\r",
									"});\r",
									"\r",
									"// 3. Number of quotes\r",
									"pm.test(\"Number of quotes is >= 0\", () => {\r",
									"    let match = xml.match(/<estimatedFreightRates[^>]*numQuotes=\"(\\d+)\"/);\r",
									"    pm.expect(match).to.not.be.null;\r",
									"    let numQuotes = parseInt(match[1]);\r",
									"    pm.expect(numQuotes).to.be.at.least(0);\r",
									"});\r",
									"\r",
									"// Only run detailed tests if there are quotes\r",
									"let numQuotes = parseInt(xml.match(/<estimatedFreightRates[^>]*numQuotes=\"(\\d+)\"/)[1]);\r",
									"if (numQuotes > 0) {\r",
									"\r",
									"    // Match all <mode> blocks\r",
									"    let modeMatches = [...xml.matchAll(/<mode[^>]*mode=\"([^\"]+)\"[\\s\\S]*?<\\/mode>/g)];\r",
									"    pm.test(\"At least one mode exists\", () => pm.expect(modeMatches.length).to.be.at.least(1));\r",
									"\r",
									"    modeMatches.forEach((modeMatch, index) => {\r",
									"        let modeBlock = modeMatch[0];\r",
									"        let modeName = modeMatch[1];\r",
									"\r",
									"        // Mode validation\r",
									"        pm.test(`Mode #${index + 1} is FCL`, () => pm.expect(modeName).to.eql(\"FCL\"));\r",
									"\r",
									"        // Prices\r",
									"        let minPrice = parseFloat(modeBlock.match(/<min>\\s*<moneyAmount[^>]*amount=\"([^\"]+)\"/)[1]);\r",
									"        let maxPrice = parseFloat(modeBlock.match(/<max>\\s*<moneyAmount[^>]*amount=\"([^\"]+)\"/)[1]);\r",
									"        pm.test(`Mode #${index + 1} prices exist`, () => {\r",
									"            pm.expect(minPrice).to.not.be.NaN;\r",
									"            pm.expect(maxPrice).to.not.be.NaN;\r",
									"        });\r",
									"        pm.test(`Mode #${index + 1} price validations`, () => {\r",
									"            pm.expect(minPrice).to.be.at.least(0);\r",
									"            pm.expect(maxPrice).to.be.at.least(minPrice);\r",
									"        });\r",
									"\r",
									"        // Currency\r",
									"        let minCurrency = modeBlock.match(/<min>\\s*<moneyAmount[^>]*currency=\"([^\"]+)\"/)[1];\r",
									"        let maxCurrency = modeBlock.match(/<max>\\s*<moneyAmount[^>]*currency=\"([^\"]+)\"/)[1];\r",
									"        pm.test(`Mode #${index + 1} currency is USD`, () => {\r",
									"            pm.expect(minCurrency).to.eql(\"USD\");\r",
									"            pm.expect(maxCurrency).to.eql(\"USD\");\r",
									"        });\r",
									"\r",
									"        // Transit times\r",
									"        let minDays = parseInt(modeBlock.match(/<transitTimes[^>]*>[\\s\\S]*<min>(\\d+)<\\/min>/)[1]);\r",
									"        let maxDays = parseInt(modeBlock.match(/<transitTimes[^>]*>[\\s\\S]*<max>(\\d+)<\\/max>/)[1]);\r",
									"        pm.test(`Mode #${index + 1} transit times exist`, () => {\r",
									"            pm.expect(minDays).to.not.be.NaN;\r",
									"            pm.expect(maxDays).to.not.be.NaN;\r",
									"        });\r",
									"        pm.test(`Mode #${index + 1} transit min <= max`, () => {\r",
									"            pm.expect(maxDays).to.be.at.least(minDays);\r",
									"        });\r",
									"    });\r",
									"} else {\r",
									"    pm.test(\"No quotes available, skipping detailed mode tests\", () => true);\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
